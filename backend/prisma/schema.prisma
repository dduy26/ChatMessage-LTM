generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int        @id @default(autoincrement())
  username    String     @unique
  email       String     @unique
  phoneNumber String?    @unique
  password    String
  avatar      String?
  bio         String?
  fullName    String?
  status      UserStatus @default(OFFLINE)
  role        Role       @default(USER)
  isBanned    Boolean    @default(false)
  banReason   String?
  lastSeen    DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  devices      Device[]
  messages     Message[]
  participants Participant[]
  notification Notification[]
  createdTasks  Task[]         @relation("CreatedTasks")
  assignedTasks Task[]         @relation("AssignedTasks")
  blockedUsers     BlockList[]        @relation("BlockerRelation")
  blockedBy        BlockList[]        @relation("BlockedRelation")
  reportsSent     Report[]        @relation("ReporterRelation")
  reportsReceived Report[]         @relation("ReportedRelation")
  
  tags Tag[]
  sentRequests     Friendship[] @relation("UserSentRequest")
  receivedRequests Friendship[] @relation("UserReceivedRequest")
  pinnedConversations PinnedConversation[]

  isVerified        Boolean            @default(false)
  verificationCodes VerificationCode[]
}

enum UserStatus {
  ONLINE
  OFFLINE
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

model Conversation {
  id        Int      @id @default(autoincrement())
  type      ConversationType @default(DIRECT)
  title     String?
  createdAt DateTime @default(now()) 

  messages  Message[]
  tasks     Task[]
  participants Participant[]
  reports   Report[]
  tags         ConversationTag[]
  pinnedConversations PinnedConversation[]
}

enum ConversationType {
  DIRECT
  GROUP 
}

model Message {
  id             Int          @id @default(autoincrement())
  content        String       @db.Text
  senderId       Int
  conversationId Int
  isEdited       Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  sender         User         @relation(fields: [senderId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  attachments    MessageAttachment[]
  deletedBy      DeletedMessage[]
  reports         Report[]
  reactions       Reaction[]
}

model Participant {
  id             Int          @id @default(autoincrement())
  userId         Int
  conversationId Int
  role           String       @default("MEMBER")
  joinedAt       DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  deletedMessages DeletedMessage[]
  reactions       Reaction[]
}

model Device {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken  String   @unique
  deviceType   String?
  deviceName   String?
  lastActive   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  content     String
  type        String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Task {
  id             Int          @id @default(autoincrement())
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       Priority     @default(MEDIUM)
  dueDate        DateTime?
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  creatorId      Int
  creator        User         @relation("CreatedTasks", fields: [creatorId], references: [id])
  assigneeId     Int?
  assignee       User?        @relation("AssignedTasks", fields: [assigneeId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
  @@index([assigneeId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model MessageAttachment {
  id        Int      @id @default(autoincrement())
  messageId Int
  fileUrl   String   @db.Text
  publicId  String
  fileName  String?
  fileType  String?
  fileSize  Int?
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model DeletedMessage {
  id            Int      @id @default(autoincrement())
  messageId     Int
  participantId Int
  createdAt     DateTime @default(now())

  message     Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([messageId, participantId])
}

model BlockList {
  id          Int      @id @default(autoincrement())
  blockerId   Int
  blockedId   Int
  createdAt   DateTime @default(now())

  blocker     User     @relation("BlockerRelation", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked     User     @relation("BlockedRelation", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Report {
  id             Int      @id @default(autoincrement())
  reporterId     Int      
  reportedUserId Int?     
  conversationId Int?     
  messageId      Int?     
  reason         String   @db.Text
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())

  reporter     User          @relation("ReporterRelation", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User?         @relation("ReportedRelation", fields: [reportedUserId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
}

model Reaction {
  id            Int      @id @default(autoincrement())
  emoji         String   
  messageId     Int
  participantId Int
  createdAt     DateTime @default(now())

  message       Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([messageId, participantId])
}

model Tag {
  id    String  @id @default(uuid())
  name  String  @unique
  color String?
  users User[]
  conversationTags ConversationTag[]
}

model ConversationTag {
  conversationId Int
  tagId          String

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag            Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
}

model Friendship {
  id          String         @id @default(uuid())
  requesterId Int
  addresseeId Int
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("UserSentRequest", fields: [requesterId], references: [id])
  addressee User @relation("UserReceivedRequest", fields: [addresseeId], references: [id])

  @@unique([requesterId, addresseeId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

model PinnedConversation {
  id             Int          @id @default(autoincrement())
  userId         Int
  conversationId Int
  pinnedAt       DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([userId])
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  code      String
  type      String
  expiresAt DateTime
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@unique([userId, type])
}