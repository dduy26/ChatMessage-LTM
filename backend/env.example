# Database configuration
# Cho Docker: DATABASE_URL sẽ được override trong docker-compose.yml
# Cho local: sử dụng localhost
DATABASE_URL="postgresql://chatapp:1234@localhost:5432/chatapp_db?schema=public"

# Port
PORT=5000

# JWT Configuration (BẮT BUỘC - phải có trong file .env ở root khi dùng Docker)
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_change_this_in_production

# Email Configuration (Tùy chọn - chỉ cần nếu dùng tính năng gửi email)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here