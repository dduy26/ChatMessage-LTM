// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// prisma/schema.prisma
// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Định nghĩa bảng User
model User {
  id          Int        @id @default(autoincrement())
  username    String     @unique
  email       String     @unique
  phoneNumber String?    @unique // Dấu ? nghĩa là có thể Null
  password    String
  avatar      String?
  bio         String?
  fullName    String?  // Dấu hỏi nghĩa là có thể để trống


  // Sử dụng Enum cho Status, mặc định là OFFLINE
  status      UserStatus @default(OFFLINE)
  
  // Sử dụng Enum cho Role, mặc định là USER
  role        Role       @default(USER)
  
  isBanned    Boolean    @default(false)
  banReason   String?
  
  lastSeen    DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?  // Thời gian xóa mềm (nếu có)

  devices      Device[]
  messages     Message[]
  participants Participant[]
  notification Notification[]
  createdTasks  Task[]         @relation("CreatedTasks")
  assignedTasks Task[]         @relation("AssignedTasks")
  blockedUsers     BlockList[]        @relation("BlockerRelation")
  blockedBy        BlockList[]        @relation("BlockedRelation")
  reportsSent     Report[]         @relation("ReporterRelation")
  reportsReceived Report[]         @relation("ReportedRelation")
  tags Tag[]
  sentRequests     Friendship[] @relation("UserSentRequest")
  receivedRequests Friendship[] @relation("UserReceivedRequest")
  pinnedConversations PinnedConversation[]

  isVerified        Boolean            @default(false) // Trạng thái xác thực tài khoản
  verificationCodes VerificationCode[]
}

// Định nghĩa các giá trị cho phép của Status
enum UserStatus {
  ONLINE
  OFFLINE
}

// Định nghĩa các giá trị cho phép của Role
enum Role {
  USER
  MODERATOR
  ADMIN
}

// Định nghĩa bảng Conversation
model Conversation {
  id        Int      @id @default(autoincrement())
  type      ConversationType @default(DIRECT)
  title     String?
  createdAt DateTime @default(now()) 

  messages  Message[]
  tasks Task[] // Một nhóm có nhiều công việc
  participants Participant[]
  reports   Report[]
  tags         ConversationTag[]
  pinnedConversations PinnedConversation[]
}

enum ConversationType {
  DIRECT
  GROUP 
}

// Định nghĩa bảng Message
model Message {
  id             Int          @id @default(autoincrement())
  content        String       @db.Text
  senderId       Int
  conversationId Int
  isEdited       Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  sender         User         @relation(fields: [senderId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  attachments    MessageAttachment[]
  deletedBy      DeletedMessage[]
  reports         Report[]
  reactions       Reaction[]
}

// Định nghĩa bảng Participant
model Participant {
  id             Int          @id @default(autoincrement())
  userId         Int
  conversationId Int
  role           String       @default("MEMBER") // Có thể là ADMIN hoặc MEMBER
  joinedAt       DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  deletedMessages DeletedMessage[]
  reactions       Reaction[]
}

// Định nghĩa bảng Device
model Device {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  deviceToken  String   @unique // Token định danh duy nhất của thiết bị (hoặc FCM Token)
  deviceType   String?  // e.g., "ios", "android", "web"
  deviceName   String?  // e.g., "iPhone 15 Pro", "Chrome Browser"
  
  lastActive   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId]) // Đánh index để truy vấn thiết bị của 1 user cho nhanh
}

// Định nghĩa bảng Notification
model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title       String   // Tiêu đề: "Tin nhắn mới"
  content     String   // Nội dung: "Nam đã gửi cho bạn một ảnh"
  type        String   // Loại: "MESSAGE", "SYSTEM", "FRIEND_REQUEST"
  isRead      Boolean  @default(false)
  
  createdAt   DateTime @default(now())

  @@index([userId])
}

// Định nghĩa bảng Task
model Task {
  id             Int          @id @default(autoincrement())
  title          String       // Tiêu đề công việc
  description    String?      // Mô tả chi tiết
  status         TaskStatus   @default(TODO)
  priority       Priority     @default(MEDIUM)
  dueDate        DateTime?    // Hạn chót
  
  // Quan hệ với Hội thoại
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  // Người tạo ra Task này
  creatorId      Int
  creator        User         @relation("CreatedTasks", fields: [creatorId], references: [id])
  
  // Người được giao Task này (Assignee)
  assigneeId     Int?
  assignee       User?        @relation("AssignedTasks", fields: [assigneeId], references: [id])

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
  @@index([assigneeId])
}

// Định nghĩa các trạng thái của Task
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

// Định nghĩa mức độ ưu tiên
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Định nghĩa bảng MessageAttachment
model MessageAttachment {
  id        Int      @id @default(autoincrement())
  messageId Int
  fileUrl   String   @db.Text    // Link từ Cloudinary
  publicId  String               // ID để xóa trên Cloudinary
  fileName  String?              // Tên file gốc
  fileType  String?              // image, video, pdf...
  fileSize  Int?                 // Dung lượng file (bytes)
  createdAt DateTime @default(now())

  // Liên kết ngược lại với Message
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

// Định nghĩa bảng DeletedMessage
model DeletedMessage {
  id            Int      @id @default(autoincrement())
  messageId     Int
  participantId Int      // Dùng participantId sẽ chuẩn hơn userId trong App Chat
  createdAt     DateTime @default(now())

  message     Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([messageId, participantId])
}

// Định nghĩa bảng BlockList
model BlockList {
  id          Int      @id @default(autoincrement())
  blockerId   Int      // Người thực hiện chặn
  blockedId   Int      // Người bị chặn
  createdAt   DateTime @default(now())

  // Định nghĩa quan hệ
  blocker     User     @relation("BlockerRelation", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked     User     @relation("BlockedRelation", fields: [blockedId], references: [id], onDelete: Cascade)

  // Đảm bảo không chặn một người nhiều lần
  @@unique([blockerId, blockedId])
}

// Định nghĩa bảng Report
model Report {
  id             Int      @id @default(autoincrement())
  reporterId     Int      
  reportedUserId Int?     
  conversationId Int?     
  messageId      Int?     
  reason         String   @db.Text
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())

  // Quan hệ
  reporter     User          @relation("ReporterRelation", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User?         @relation("ReportedRelation", fields: [reportedUserId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
}

// Định nghĩa bảng Reaction
model Reaction {
  id            Int      @id @default(autoincrement())
  emoji         String   
  messageId     Int
  participantId Int      // Đổi từ userId sang participantId
  createdAt     DateTime @default(now())

  message       Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  // Một người (participant) chỉ thả 1 loại cảm xúc vào 1 tin nhắn
  @@unique([messageId, participantId])
}

// Định nghĩa bảng Tag
model Tag {
  id    String  @id @default(uuid())
  name  String  @unique
  color String?
  users User[]
  conversationTags ConversationTag[]
}

// Định nghĩa bảng ConversationTag
model ConversationTag {
  conversationId Int
  tagId          String

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag            Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId]) // Khóa chính tổ hợp
}

// Định nghĩa bảng Friendship
model Friendship {
  id          String           @id @default(uuid())
  requesterId Int
  addresseeId Int
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("UserSentRequest", fields: [requesterId], references: [id])
  addressee User @relation("UserReceivedRequest", fields: [addresseeId], references: [id])

  @@unique([requesterId, addresseeId])
}

// Enum cho Friendship (Đặt ở đây là đúng rồi)
enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

// Định nghĩa bảng PinnedConversation
model PinnedConversation {
  id             Int          @id @default(autoincrement())
  userId         Int
  conversationId Int
  pinnedAt       DateTime     @default(now())

  // Quan hệ
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Một người chỉ ghim một cuộc hội thoại một lần
  @@unique([userId, conversationId])
  @@index([userId])
}

// Định nghĩa bảng VerificationCode
model VerificationCode {
  id        Int      @id @default(autoincrement())
  code      String   // 6 chữ số
  type      String   // "REGISTER", "FORGOT_PASSWORD"
  expiresAt DateTime
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}