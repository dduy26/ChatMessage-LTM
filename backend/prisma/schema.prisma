// prisma/schema.prisma
// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Định nghĩa bảng User
model User {
  id          Int        @id @default(autoincrement())
  username    String     @unique
  email       String     @unique
  phoneNumber String?    @unique // Dấu ? nghĩa là có thể Null
  password    String
  avatar      String?
  bio         String?
  fullName    String?  // Dấu hỏi nghĩa là có thể để trống


  // Sử dụng Enum cho Status, mặc định là OFFLINE
  status      UserStatus @default(OFFLINE)
  
  // Sử dụng Enum cho Role, mặc định là USER
  role        Role       @default(USER)
  
  isBanned    Boolean    @default(false)
  banReason   String?
  
  lastSeen    DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?  // Thời gian xóa mềm (nếu có)
}

// Định nghĩa các giá trị cho phép của Status
enum UserStatus {
  ONLINE
  OFFLINE
}

// Định nghĩa các giá trị cho phép của Role
enum Role {
  USER
  MODERATOR
  ADMIN
}

// Định nghĩa bảng Conversation
model Conversation {
  id        Int      @id @default(autoincrement())
  type      ConversationType @default(DIRECT)
  title     String?
  createdAt DateTime @default(now()) 
}

enum ConversationType {
  DIRECT
  GROUP 
}