# Database configuration
# Khi chạy trong Docker, DATABASE_URL sẽ được override bởi docker-compose.yml
# Khi chạy local (không Docker), dùng connection string này:
DATABASE_URL="postgresql://chatapp:1234@localhost:5432/chatapp_db?schema=public"

# Port
PORT=5000

# JWT Secrets (QUAN TRỌNG - phải có để login/register hoạt động)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
REFRESH_TOKEN_SECRET="your-refresh-token-secret-change-this-in-production"

# Email configuration (cho OTP và verification)
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"