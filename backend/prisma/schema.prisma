// prisma/schema.prisma
// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Định nghĩa bảng User
model User {
  id          Int        @id @default(autoincrement())
  username    String     @unique
  email       String     @unique
  phoneNumber String?    @unique // Dấu ? nghĩa là có thể Null
  password    String
  avatar      String?
  bio         String?
  fullName    String?  // Dấu hỏi nghĩa là có thể để trống


  // Sử dụng Enum cho Status, mặc định là OFFLINE
  status      UserStatus @default(OFFLINE)
  
  // Sử dụng Enum cho Role, mặc định là USER
  role        Role       @default(USER)
  
  isBanned    Boolean    @default(false)
  banReason   String?
  
  lastSeen    DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?  // Thời gian xóa mềm (nếu có)
  // Relation: User có thể gửi nhiều lời mời và nhận nhiều lời mời
  sentRequests     Friendship[] @relation("UserSentRequest")
  receivedRequests Friendship[] @relation("UserReceivedRequest")

  // Relation: User có thể có nhiều Tag
  tags Tag[]
}

// Bảng Friendship (Đã sửa để khớp với ID số)
model Friendship {
  id          String   @id @default(uuid()) // ID của chính bảng này để String cho an toàn
  
  // QUAN TRỌNG: Hai dòng này phải là Int để trỏ về User
  requesterId Int      
  addresseeId Int      
  
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Khai báo quan hệ
  requester   User @relation("UserSentRequest", fields: [requesterId], references: [id])
  addressee   User @relation("UserReceivedRequest", fields: [addresseeId], references: [id])

  // Đảm bảo không trùng cặp
  @@unique([requesterId, addresseeId])
}

// Bảng Tag
model Tag {
  id    String @id @default(uuid())
  name  String @unique
  color String?  // Trường color: Lưu mã màu (ví dụ: "#FF0000"). // Để dấu ? (String?) để có thể bỏ trống nếu không muốn chọn màu.
  users User[]

}

// Định nghĩa các giá trị cho phép của Status
enum UserStatus {
  ONLINE
  OFFLINE
}

// Định nghĩa các giá trị cho phép của Role
enum Role {
  USER
  MODERATOR
  ADMIN
}
// Định nghĩa các giá trị cho phép của FriendshipStatus
enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}