generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================
// 1. MODEL USER (Đã thêm các dòng còn thiếu)
// ==============================
model User {
  id          Int     @id @default(autoincrement())
  username    String  @unique
  email       String  @unique
  phoneNumber String? @unique
  password    String
  avatar      String?
  bio         String?
  fullName    String?

  status UserStatus @default(OFFLINE)
  role   Role       @default(USER)

  isBanned  Boolean @default(false)
  banReason String?

  lastSeen  DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // --- CÁC MỐI QUAN HỆ (ĐÃ SỬA ĐẦY ĐỦ) ---

  // 1. Friendship
  sentRequests     Friendship[] @relation("UserSentRequest")
  receivedRequests Friendship[] @relation("UserReceivedRequest")

  // 2. Chat & Group
  messages     Message[]
  participants Participant[]

  // 3. Tag
  tags Tag[]

  // 4. Device & Notification (Thêm mới để sửa lỗi hình 3)
  devices       Device[]
  notifications Notification[]

  // 5. Task (Thêm mới để sửa lỗi logic Task)
  createdTasks  Task[] @relation("CreatedTasks")
  assignedTasks Task[] @relation("AssignedTasks")
}

// ==============================
// 2. MODEL FRIENDSHIP
// ==============================
model Friendship {
  id          String           @id @default(uuid())
  requesterId Int
  addresseeId Int
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("UserSentRequest", fields: [requesterId], references: [id])
  addressee User @relation("UserReceivedRequest", fields: [addresseeId], references: [id])

  @@unique([requesterId, addresseeId])
}

// Enum cho Friendship (Đặt ở đây là đúng rồi)
enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

// ==============================
// 3. CÁC MODEL KHÁC (Giữ nguyên)
// ==============================

model Tag {
  id    String  @id @default(uuid())
  name  String  @unique
  color String?
  users User[]
}

enum UserStatus {
  ONLINE
  OFFLINE
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

model Conversation {
  id        Int              @id @default(autoincrement())
  type      ConversationType @default(DIRECT)
  title     String?
  createdAt DateTime         @default(now())

  messages     Message[]
  tasks        Task[]
  participants Participant[]
}

enum ConversationType {
  DIRECT
  GROUP
}

model Message {
  id             Int      @id @default(autoincrement())
  content        String   @db.Text
  senderId       Int
  conversationId Int
  isEdited       Boolean  @default(false)
  isDeleted      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sender       User         @relation(fields: [senderId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])
}

model Participant {
  id             Int      @id @default(autoincrement())
  userId         Int
  conversationId Int
  role           String   @default("MEMBER")
  joinedAt       DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])
}

model Device {
  id     Int  @id @default(autoincrement())
  userId Int
  // Lỗi ở hình 3 là do dòng này thiếu đối ứng bên User
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceToken String  @unique
  deviceType  String?
  deviceName  String?

  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Notification {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  content String
  type    String
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?

  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  creatorId Int
  creator   User @relation("CreatedTasks", fields: [creatorId], references: [id])

  assigneeId Int?
  assignee   User? @relation("AssignedTasks", fields: [assigneeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId])
  @@index([assigneeId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
